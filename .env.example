# ---------------------------------------------------------------------------
# KnowledgeForge configuration
#
# Copy to `.env` and fill in what you have. Everything is optional: with no
# Azure credentials the app runs in LOCAL mode (in-memory vector store,
# deterministic hash embeddings, extractive mock LLM). Setting all four
# AZURE_OPENAI_* / AZURE_SEARCH_* values flips the app into AZURE mode.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=KnowledgeForge
LOG_LEVEL=INFO

# HS256 secret used to sign/verify API JWTs (>= 32 bytes).
# Leave blank locally: the app generates a random key per process. A published
# constant here would mean anyone could mint an admin token against any
# instance of this demo. Azure mode refuses to start without a strong value.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_TTL_MINUTES=60

# Local quickstart ONLY: when true, tokenless requests act as a dev admin so
# the README curl examples work. Default false; startup fails if this is set
# together with Azure credentials.
ALLOW_ANONYMOUS_DEV_ADMIN=false

# --- Retrieval tuning ------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
EMBEDDING_DIMENSIONS=256        # local hash embedder only; Azure uses model dims
RETRIEVAL_TOP_K=5
AGENT_MAX_ITERATIONS=4

# --- Azure OpenAI (chat + embeddings) --------------------------------------
AZURE_OPENAI_ENDPOINT=          # e.g. https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# --- Azure AI Search (hybrid vector + keyword index) ------------------------
AZURE_SEARCH_ENDPOINT=          # e.g. https://<service>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=knowledgeforge-chunks

# --- Azure AI Language (PII detection; falls back to regex redactor) --------
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_API_KEY=

# --- Azure AI Content Safety (falls back to keyword gate) -------------------
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_API_KEY=

# --- Azure Blob Storage (batch ingestion pipeline) ---------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=incoming-docs
